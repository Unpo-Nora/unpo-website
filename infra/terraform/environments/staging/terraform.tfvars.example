# Ejemplo de variables para el entorno staging.
# Copiar a terraform.tfvars y ajustar. El terraform.tfvars real está
# gitignoreado. NO cargar secretos ni valores sensibles reales acá.

project     = "unpo-nora"
environment = "staging"
region      = "sa-east-1"

# --- Red ---
vpc_cidr             = "10.20.0.0/16"
azs                  = ["sa-east-1a", "sa-east-1b"]
public_subnet_cidrs  = ["10.20.0.0/24", "10.20.1.0/24"]
private_subnet_cidrs = ["10.20.10.0/24", "10.20.11.0/24"]

enable_nat_gateway = true
single_nat_gateway = true # staging: 1 sola NAT para bajar costo

# --- App / DB ---
app_port = 8000
db_port  = 5432

# --- ECR ---
ecr_repository_names = ["backend", "frontend"]

# --- Tags adicionales (opcional; sin datos sensibles) ---
extra_tags = {
  Owner = "sistemas"
}
