# Variables de entorno del proyecto (raíz). Este archivo documenta NOMBRES, nunca valores.
# Copiar a `.env` y completar. `.env` está gitignoreado y NO debe commitearse.

# --- Base de datos (docker-compose la inyecta al backend vía env_file) ---
DATABASE_URL=

# --- Postgres del docker-compose (deben coincidir con DATABASE_URL) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Backend: auth/JWT ---
SECRET_KEY=
ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
ACCESS_TOKEN_EXPIRE_MINUTES_STAFF=

# --- Backend: CORS (lista separada por comas) ---
CORS_ORIGINS=

# --- Meta / Facebook Lead Ads (UNPO) ---
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=

# --- Meta / Facebook Lead Ads (NORA) ---
NORA_META_PAGE_ACCESS_TOKEN=
NORA_META_VERIFY_TOKEN=

# --- Supabase (almacenamiento de imágenes de producto) ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=

# --- WhatsApp Cloud API: ver backend/.env.example ---

# --- Frontend (Next.js lee NEXT_PUBLIC_*; BACKEND_URL es para el rewrite de next.config.mjs) ---
NEXT_PUBLIC_API_URL=
BACKEND_URL=
